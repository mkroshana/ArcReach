# Every environment variable the app reads. Generate each secret below with either of:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production (NODE_ENV=production) the server refuses to start while SESSION_SECRET,
# SECRETS_KEY or UNSUBSCRIBE_SECRET is unset, shorter than 32 characters, contains
# "placeholder" or "change_me", or is an example or dev fallback value published in this
# repository. Left empty locally, each falls back to such a published dev value.

# APP_URL: The public URL of the app, without a trailing slash. Every tracked link, open
# pixel and unsubscribe link in a sent email is built on it. Required in production, where
# it must be https and not localhost (e.g. https://arcreach-app.azurewebsites.net).
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL database connection URL (e.g. from Neon or local Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/arcreach?schema=public"

# SESSION_SECRET: Signs the session cookie (JWT). Required in production. Changing it signs
# everyone out.
SESSION_SECRET=""

# SECRETS_KEY: Encrypts the Azure connection string and mailbox passwords stored in the
# database (AES-256-GCM): 64 hex characters, or any value of at least 32 characters.
# Required in production. Set it once and keep it: stored secrets cannot be decrypted with
# another key. Left empty, the key published in this repository is used, so set your own
# whenever DATABASE_URL points at a shared database.
SECRETS_KEY=""

# WEBHOOK_SECRET: The Azure Event Grid delivery-report webhook (/api/webhook) accepts only
# requests whose X-ArcReach-Webhook-Secret header (an Event Grid delivery property) equals
# it. Without it, or in production while it is a placeholder or a published example, the
# webhook refuses every request.
WEBHOOK_SECRET=""

# UNSUBSCRIBE_SECRET: Signs the unsubscribe link in every campaign email (HMAC-SHA256
# over the lead and dispatch ids). Required in production.
# Set it once and keep it: changing it breaks the unsubscribe links in every email already sent.
UNSUBSCRIBE_SECRET=""

# UNSUBSCRIBE_MAILTO: Optional. An address added to the List-Unsubscribe header of campaign
# emails next to the one-click https link, for mail clients that only offer mailto. Nothing
# in the app reads that inbox, so only set it if someone processes those requests by hand.
UNSUBSCRIBE_MAILTO=""

# Initial Admin Seeding Configuration (`npm run seed`)
# The seed creates this admin only while the database has no admin, and never changes an
# existing user. Leave ADMIN_PASSWORD empty to be asked for the password in the terminal;
# there is no default, and the old published default is refused.
ADMIN_EMAIL="admin@arcreach.com"
ADMIN_PASSWORD=""
ADMIN_NAME="ArcReach Admin"

# DEMO_USER_PASSWORD: Local and test databases only. `npm run seed:dev` and `npm run dev`
# add the dev users admin@arcreach.com (password ADMIN_PASSWORD) and mkroshana@gmail.com
# (this password), each "securepassword123" when its variable is empty.
DEMO_USER_PASSWORD=""

# SEND_WORKER_ENABLED: Set to "true" only where campaign email should be sent and
# IMAP replies synced (the Azure App Service). Leave it "false" locally so `npm run dev`
# against a shared database never sends. If several processes enable it, a database
# lease lets only one of them run the worker at a time.
SEND_WORKER_ENABLED="false"

# DOMAIN_CHECK_DNS_SERVERS: Optional. DNS server IP addresses, separated by commas, that
# the leads page's Check Domain MX asks instead of the system's (e.g. "10.0.0.1" or
# "1.1.1.1,8.8.8.8"). Only for a machine where the check stops with "No DNS server
# answered" because Node cannot find the system's DNS servers; leave it empty elsewhere.
DOMAIN_CHECK_DNS_SERVERS=""

# DISABLE_HMR: Development only. "true" stops `npm run dev` watching files for changes.
DISABLE_HMR="false"

# NODE_ENV, NEXT_PHASE and NEXT_RUNTIME are set by Next.js; do not set them here.
