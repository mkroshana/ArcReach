# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL database connection URL (e.g. from Neon or local Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/arcreach?schema=public"

# Hardened Server-Only Secrets (minimum 32 chars for session key)
SESSION_SECRET="arcreach_session_secret_jwt_32_chars_long_placeholder"
WEBHOOK_SECRET="whsec_placeholder_secret_key_12345"

# Initial Admin Seeding Configuration
ADMIN_EMAIL="admin@arcreach.com"
ADMIN_PASSWORD="securepassword123"
ADMIN_NAME="ArcReach Admin"
