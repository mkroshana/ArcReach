generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. USERS & RBAC
// ------------------------------------------------------
enum Role {
  ADMIN
  USER
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  organization   String?
  timezone       String?
  passwordHash   String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  
  // Ownership Relations
  campaigns      Campaign[]
  senderAccounts SenderAccount[]
}

// ------------------------------------------------------
// 2. GLOBAL SETTINGS
// ------------------------------------------------------
// Single row under the fixed id "global"; read and write it via lib/settings.ts.
model GlobalSettings {
  id                String   @id @default("global")
  activeProvider    String   @default("DISABLED") // AZURE sends; DISABLED (or anything else) sends nothing
  azureConnString   String?
  azureSenderDomain String?  // deprecated — read-only fallback for migration to azureSenderDomains
  azureSenderDomains Json?   // string[] of verified sender domains
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPass          String?
  imapHost          String?
  imapPort          Int?
  imapUser          String?
  imapPass          String?
  rateLimitMinute   Int?     @default(60)
  rateLimitHour     Int?     @default(1000)
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------
// 3. SENDER ACCOUNTS & HEALTH
// ------------------------------------------------------
model SenderAccount {
  id              String            @id @default(uuid())
  emailAddress    String            @unique
  name            String?           // Matches UI displayed sender name
  replyTo         String?
  provider        String
  status          String            @default("Active")
  
  // Ownership
  userId          String
  // Restrict: deleting a user must never take their mailboxes with them.
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // Granular Sending Frequency & Limits
  minuteLimit     Int               @default(2)
  hourlyLimit     Int               @default(40)
  dailyLimit      Int               @default(500)
  dailyMax        Int               @default(500)     // Matches dailyMax target in UI
  
  // Warmup & Deliverability Telemetry
  warmupEnabled   Boolean           @default(false)
  warmupStartedAt DateTime?
  reputationScore Decimal           @default(100.0) @db.Decimal(5, 2)
  warmupLimit     Int               @default(50)
  warmupRamp      Int               @default(2)
  warmupSent      Int               @default(0)       // Matches warmupSent count in UI
  savedSpam       Int               @default(0)       // Matches savedSpam count in UI
  savedPromo      Int               @default(0)       // Matches savedPromo count in UI
  warmupReplies   Int               @default(0)       // Matches warmupReplies count in UI
  
  campaigns       Campaign[]
  campaignPool    CampaignSenderAccount[]
  inboundReplies  InboundResponse[]
  dispatches      EmailDispatch[]

  // Individual Mailbox Credentials
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPass        String?
  imapHost        String?
  imapPort        Int?
  imapUser        String?
  imapPass        String?
}

// ------------------------------------------------------
// 4. CAMPAIGNS & SEQUENCES
// ------------------------------------------------------
model Campaign {
  id              String               @id @default(uuid())
  name            String
  status          String               @default("Draft")
  
  // Ownership
  userId          String
  // Restrict: deleting a user must never take their campaigns and their history with them.
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  senderAccountId String
  // Restrict: deleting a mailbox must never take its campaigns and their history with it.
  senderAccount   SenderAccount        @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // When set, the send engine auto-resumes this campaign to Active once
  // `pausedUntil <= now`. Null = paused indefinitely (manual pause). Only the
  // send engine sets it, when it pauses an Active campaign; any status a user
  // sets clears it.
  pausedUntil     DateTime?
  // Why the campaign is Paused: 'quota', 'systemic' or 'config' when the send
  // engine paused it (with pausedUntil), 'user' when a user did. Null otherwise.
  pauseReason     String?

  // Advanced scheduling and options (From original schema & UI elements)
  timezone        String               @default("UTC")
  sendSchedule    Json?                // E.g., {"days": ["Mon","Tue","Wed","Thu","Fri"], "window": {"start": "09:00", "end": "17:00"}}
  stopOnReply     Boolean              @default(true)
  trackOpens      Boolean              @default(true)
  trackClicks     Boolean              @default(true)
  audienceCohort  String               @default("Valid") // Valid, Unverified, etc.
  
  steps           CampaignStep[]
  enrollments     CampaignEnrollment[]
  dispatches      EmailDispatch[]
  replies         InboundResponse[]
  senders         CampaignSenderAccount[]
}

model CampaignSenderAccount {
  campaignId      String
  senderAccountId String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderAccount   SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@id([campaignId, senderAccountId])
}

model CampaignStep {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder  Int      // 1, 2, 3... 
  waitDays   Int      @default(0)
  subject    String
  body       String   @db.Text
  isABTest   Boolean  @default(false) // Matches AB variation trigger in UI
}

// ------------------------------------------------------
// 5. LEADS & ENROLLMENT (The Junction Architecture)
// ------------------------------------------------------
enum LeadStatus {
  Neutral
  Interested
  Not_Interested
  Meeting_Booked
  Out_of_Office
  Bounced
  Unsubscribed
}

enum LeadValidationStatus {
  Valid
  Invalid
  Risky
  Unverified
}

model Lead {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String?              // Unified name field matching the UI
  company          String?              // Unified company field matching variables {{company}}
  jobTitle         String?              // Job title of the lead
  status           LeadStatus           @default(Neutral) // Global CRM status values
  validationStatus LeadValidationStatus @default(Unverified) // Matches bulk verification categories
  customVariables  Json?                // Holds extra CSV metadata cols
  isArchived       Boolean              @default(false)   // Is the lead archived?
  
  enrollments      CampaignEnrollment[]
  dispatches       EmailDispatch[]
  replies          InboundResponse[]
  groups           LeadGroupMembership[]
}

model LeadGroup {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  leads       LeadGroupMembership[]
}

model LeadGroupMembership {
  leadId      String
  groupId     String
  lead        Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  group       LeadGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([leadId, groupId])
}

// Junction table mapping leads globally to specific campaigns
model CampaignEnrollment {
  id                  String     @id @default(uuid())
  leadId              String
  campaignId          String
  lead                Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign            Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  status              String     @default("Active") // Enrollment status: Active, Paused, Bounced, Completed
  enrolledAt          DateTime   @default(now())

  // Sequence Execution State per campaign (moved from Lead for multiple concurrent campaigns support)
  currentSequenceStep Int        @default(1)        // Step order tracking
  nextActionDate      DateTime?                     // Trigger timestamp for worker scheduler
  retryCount          Int        @default(0)
  // Quota refusals matched only by their wording, in a row on this enrollment.
  // After 5 the send engine handles the next one as a soft failure of this
  // lead instead of pausing the campaign again. A sent step or a soft or hard
  // failure resets it; ACS's own 429 or quota code and a systemic failure
  // (settings, credentials, clock) leave it alone.
  quotaFailures       Int        @default(0)
  lastError           String?
  lastBounceType      String?

  // Per-send claim taken via lib/sendEligibility.ts right before a send and
  // released when it finishes; a claim older than 10 minutes counts as abandoned.
  claimToken          String?
  claimedAt           DateTime?

  // Prevents enrolling the same lead into the same campaign twice
  @@unique([leadId, campaignId]) 
  // Serves the send engine's due query: Active rows by nextActionDate, oldest first.
  @@index([status, nextActionDate])
}

// ------------------------------------------------------
// 6. DISPATCH & EVENT TRACKING
// ------------------------------------------------------
model EmailDispatch {
  id          String        @id @default(uuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccountId String?
  senderAccount   SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  campaignId  String?
  // SetNull: deleting a campaign keeps what it sent, so tracked links and send caps survive.
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messageId   String        @unique
  sentAt      DateTime      @default(now())
  subject     String?
  body        String?       @db.Text

  // Send-attempt outcome: "Sending" (recorded before the provider call), "Sent"
  // (accepted by the provider), "Failed" (provider/SMTP error) or "Unknown" (an
  // interrupted send ACS could not confirm; never resent, counted toward caps
  // and rate limits but not as sent). lib/sendReconciler.ts settles stale
  // "Sending" rows with ACS.
  status      String        @default("Sending")
  // ACS Operation-Id the send was made under, stored before the provider call
  // so an accepted send whose bookkeeping failed can still be traced in ACS.
  // Null for rows recorded after the send (Unibox replies) or before this column.
  operationId String?       @unique
  // Sequence step this dispatch belongs to (null for manual / non-campaign sends).
  stepOrder   Int?
  // Set by the Azure delivery webhook when the message is confirmed delivered.
  deliveredAt DateTime?

  events      EmailEvent[]

  // Speeds up the per-(campaign, lead, step) idempotency guard.
  @@index([campaignId, leadId, stepOrder])
}

model EmailEvent {
  id         String        @id @default(uuid())
  messageId  String
  dispatch   EmailDispatch @relation(fields: [messageId], references: [messageId], onDelete: Cascade)
  eventType  String
  clickedUrl String?
  timestamp  DateTime      @default(now())
}

// ------------------------------------------------------
// 7. UNIBOX INBOUND REPLIES
// ------------------------------------------------------
model InboundResponse {
  id              String         @id @default(uuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId      String?
  // SetNull: deleting a campaign must never take the prospect's replies out of Unibox.
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderAccountId String?        // Captures which account received the inbound reply
  senderAccount   SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  subject         String
  body            String         @db.Text
  receivedAt      DateTime       @default(now())
  unread          Boolean        @default(true)
}

// ------------------------------------------------------
// 8. COPY LIBRARY / TEMPLATES
// ------------------------------------------------------
model Template {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String   @db.Text
  category  String
  steps     Json?    // Optional JSON array of steps: [{ id, waitDays, subject, body }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// 9. BACKGROUND WORKER LEASE
// ------------------------------------------------------
// One row per lease, taken and renewed via lib/workerLease.ts. Only the process
// holding the "send-worker" lease runs the send and IMAP sync loops.
model WorkerLease {
  name          String    @id
  holderId      String    // random id of the holding process
  expiresAt     DateTime  // another process may take the lease after this
  lastTickAt    DateTime? // start of the holder's last finished send tick
  lastSuccessAt DateTime? // end of the last send tick that finished without an error
  lastError     String?   // error from the last send tick; cleared when one succeeds
}
